APP_NAME="BurakoBoard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://jagarcell.ddns.net
APP_PORT=80
APP_ROOT_DOMAINS=localhost,jagarcell.ddns.net
APP_DOMAIN=jagarcell.ddns.net
ADMIN_DOMAIN=admin.jagarcell.ddns.net
API_DOMAIN=api.jagarcell.ddns.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=burakoboard_db
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6381

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,localhost:443,127.0.0.1,127.0.0.1:80,127.0.0.1:443,jagarcell.ddns.net,jagarcell.ddns.net:80,jagarcell.ddns.net:443,admin.jagarcell.ddns.net,api.jagarcell.ddns.net
CORS_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1,https://jagarcell.ddns.net,https://admin.jagarcell.ddns.net,https://api.jagarcell.ddns.net

REVERB_APP_ID=burakoboard
REVERB_APP_KEY=burakoboard-key
REVERB_APP_SECRET=burakoboard-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FORWARD_REVERB_PORT=8081

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
